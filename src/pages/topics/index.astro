---
// src/pages/topics/index.astro
// Topics index — browsable tag page.
// Toggle: A–Z / Most Discourses (client-side, no reload).

import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const discourses = await getCollection('discourses', ({ data }) => data.status === 'published');

// Build topic → count map
const topicMap = new Map<string, number>();
for (const d of discourses) {
  for (const t of d.data.topic) {
    topicMap.set(t, (topicMap.get(t) ?? 0) + 1);
  }
}

// Serialise for client-side sort toggle
const topics = Array.from(topicMap.entries()).map(([name, count]) => ({ name, count }));
const topicsJson = JSON.stringify(topics);
---

<BaseLayout title="Topics">
  <Header slot="header" />

  <div class="topics-page">
    <div class="topics-inner">
      <header class="page-header">
        <h1 class="page-title">Topics</h1>
        <p class="page-subtitle">
          {topicMap.size} topic{topicMap.size !== 1 ? 's' : ''} across {discourses.length} discourse{discourses.length !== 1 ? 's' : ''}
        </p>
      </header>

      <!-- Sort toggle -->
      <div class="sort-toggle" role="group" aria-label="Sort topics by">
        <button id="sort-az" class="sort-btn sort-btn--active" aria-pressed="true">A–Z</button>
        <button id="sort-count" class="sort-btn" aria-pressed="false">Most Discourses</button>
      </div>

      <!-- Topic grid -->
      <div id="topic-grid" class="topic-grid" data-topics={topicsJson}>
        {topics
          .sort((a, b) => a.name.localeCompare(b.name))
          .map(({ name, count }) => (
            <a
              href={`/topics/${encodeURIComponent(name.toLowerCase())}`}
              class="topic-pill"
              data-name={name}
              data-count={count}
            >
              <span class="pill-name">{name}</span>
              <span class="pill-count" aria-label={`${count} discourse${count !== 1 ? 's' : ''}`}>
                {count}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .topics-page { padding-block: 2rem 4rem; }

  .topics-inner {
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .page-header { margin-bottom: 2rem; }

  .page-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .sort-toggle {
    display: flex;
    gap: 0.375rem;
    margin-bottom: 1.75rem;
  }

  .sort-btn {
    padding: 0.45rem 1rem;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: none;
    font-size: 0.85rem;
    font-family: inherit;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .sort-btn--active {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent);
  }

  .topic-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .topic-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-text-primary);
    transition: border-color 0.15s, background 0.15s;
    font-size: 0.875rem;
  }

  .topic-pill:hover,
  .topic-pill:focus-visible {
    border-color: var(--color-accent-primary);
    background: color-mix(in srgb, var(--color-accent-primary) 6%, transparent);
    color: var(--color-accent-primary);
  }

  .pill-name { font-weight: 500; }

  .pill-count {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    background: var(--color-bg-light);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    min-width: 1.5rem;
    text-align: center;
  }

</style>

<script>
  const grid = document.getElementById('topic-grid') as HTMLElement | null;
  const sortAZ = document.getElementById('sort-az') as HTMLButtonElement | null;
  const sortCount = document.getElementById('sort-count') as HTMLButtonElement | null;

  function setSort(mode: 'az' | 'count') {
    if (!grid) return;

    const pills = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.topic-pill'));

    pills.sort((a, b) => {
      if (mode === 'az') {
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      } else {
        return Number(b.dataset.count ?? 0) - Number(a.dataset.count ?? 0);
      }
    });

    // Re-append in sorted order
    pills.forEach(p => grid.appendChild(p));

    sortAZ?.setAttribute('aria-pressed', String(mode === 'az'));
    sortCount?.setAttribute('aria-pressed', String(mode === 'count'));
    sortAZ?.classList.toggle('sort-btn--active', mode === 'az');
    sortCount?.classList.toggle('sort-btn--active', mode === 'count');
  }

  sortAZ?.addEventListener('click', () => setSort('az'));
  sortCount?.addEventListener('click', () => setSort('count'));
</script>
