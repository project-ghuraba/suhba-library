---
// src/pages/index.astro
// Home page — reading room layout.
// Sections: hero, Wisdom of the Day, search bar, Latest Suhbas, On This Day.

import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import DiscourseCard from '../components/discourse/DiscourseCard.astro';
import { getCollection } from 'astro:content';

// Fetch published discourses, sorted newest first
const allDiscourses = await getCollection('discourses', ({ data }) => data.status === 'published');
allDiscourses.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latest = allDiscourses.slice(0, 10);

// On This Day — match today's month and day across all years
const today = new Date();
const todayMonth = today.getMonth();
const todayDay = today.getDate();

const onThisDay = allDiscourses.filter(d => {
  const d2 = d.data.date;
  return d2.getMonth() === todayMonth && d2.getDate() === todayDay;
});

// Wisdom of the Day — deterministic daily quote via seeded selection
// Load all verified quotes from all discourses
const allQuotes: { quote: string; slug: string; title: string }[] = [];
for (const d of allDiscourses) {
  for (const q of d.data.quotes_verified ?? []) {
    allQuotes.push({ quote: q, slug: d.data.slug, title: d.data.title });
  }
}

// Seeded PRNG — seed = ISO date string converted to integer
function seededIndex(seed: string, max: number): number {
  let hash = 0;
  for (let i = 0; i < seed.length; i++) {
    hash = ((hash << 5) - hash) + seed.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash) % max;
}

const todayISO = today.toISOString().split('T')[0];
const wisdomOfTheDay = allQuotes.length > 0
  ? allQuotes[seededIndex(todayISO, allQuotes.length)]
  : null;

const siteUrl = Astro.site?.toString() ?? 'https://library.suhba.org';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The Suhba Library',
  url: siteUrl,
  description: 'A Digital Waqf — preserving thousands of spiritual discourses for seekers, readers, and AI systems.',
};
---

<BaseLayout
  title="The Suhba Library"
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="hero">
    <h1 class="hero-title">The Suhba Library</h1>
    <p class="hero-tagline">
      A Digital Waqf — preserving the light of spiritual discourse for all who seek.
    </p>
  </section>

  <!-- Wisdom of the Day -->
  {wisdomOfTheDay ? (
    <section class="section wisdom-section" aria-labelledby="wisdom-heading">
      <p class="section-label" id="wisdom-heading">Wisdom of the Day</p>
      <blockquote id="wisdom-quote" class="wisdom-quote">
        <p>"{wisdomOfTheDay.quote}"</p>
        <footer>
          <a href={`/suhba/${wisdomOfTheDay.slug}`}>{wisdomOfTheDay.title}</a>
        </footer>
      </blockquote>

      <div class="wisdom-actions">
        <button
          id="copy-quote"
          class="action-btn"
          aria-label="Copy this quote to clipboard"
          data-quote={wisdomOfTheDay.quote}
        >
          Copy
        </button>
        <button
          id="random-quote"
          class="action-btn"
          aria-label="Show a random quote"
          data-quotes={JSON.stringify(allQuotes)}
        >
          Random quote
        </button>
      </div>
    </section>
  ) : (
    <section class="section wisdom-section">
      <p class="section-label">Wisdom of the Day</p>
      <p class="empty-state">No verified quotes yet. Add <code>quotes_verified</code> to discourse frontmatter.</p>
    </section>
  )}

  <!-- Search bar -->
  <section class="section search-section">
    <form action="/search" method="get" role="search" class="home-search-form">
      <label for="home-search" class="sr-only">Search discourses</label>
      <input
        type="search"
        id="home-search"
        name="q"
        placeholder="Search discourses…"
        class="home-search-input"
        autocomplete="off"
      />
      <button type="submit" class="search-btn" aria-label="Submit search">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </form>
    <p class="search-sub">
      <a href="/search">Advanced search & filters →</a>
    </p>
  </section>

  <!-- Latest Suhbas -->
  <section class="section" aria-labelledby="latest-heading">
    <h2 class="section-heading" id="latest-heading">Latest Suhbas</h2>
    {latest.length > 0 ? (
      <div class="discourse-list">
        {latest.map(d => (
          <DiscourseCard
            title={d.data.title}
            slug={d.data.slug}
            date={d.data.date}
            dateHijri={d.data.date_hijri}
            speakers={d.data.speaker}
            locationCountry={d.data.location_country}
            locationCity={d.data.location_city}
            topics={d.data.topic}
            transcriptQuality={d.data.transcript_quality}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">No published discourses yet.</p>
    )}
    <a href="/search" class="view-all-link">View all discourses →</a>
  </section>

  <!-- On This Day -->
  <section class="section" aria-labelledby="otd-heading">
    <h2 class="section-heading" id="otd-heading">On This Day</h2>
    {onThisDay.length > 0 ? (
      <div class="discourse-list">
        {onThisDay.map(d => (
          <DiscourseCard
            title={d.data.title}
            slug={d.data.slug}
            date={d.data.date}
            dateHijri={d.data.date_hijri}
            speakers={d.data.speaker}
            locationCountry={d.data.location_country}
            locationCity={d.data.location_city}
            topics={d.data.topic}
            transcriptQuality={d.data.transcript_quality}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">
        No discourses recorded on this date in other years. Check back tomorrow.
      </p>
    )}
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding-block: 4rem 2rem;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .hero-title {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary);
  }

  .hero-tagline {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 42ch;
    margin-inline: auto;
    line-height: 1.6;
  }

  .section {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
    padding-block: 2rem 0;
  }

  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-secondary);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .section-heading {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--color-text-primary);
  }

  .wisdom-section { border-left: 3px solid var(--color-accent-secondary); padding-left: 1.25rem; }

  .wisdom-quote {
    margin: 0 0 1rem;
    padding: 0;
    border: none;
  }

  .wisdom-quote p {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }

  .wisdom-quote footer {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .wisdom-quote footer a {
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  .wisdom-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .action-btn {
    font-size: 0.825rem;
    padding: 0.5rem 1rem;
    min-height: 44px;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    font-family: inherit;
    transition: border-color 0.15s, color 0.15s;
  }

  .action-btn:hover,
  .action-btn:focus-visible {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .home-search-form {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    max-width: 36rem;
    background: var(--color-surface-light);
  }

  html.dark .home-search-form {
    background: var(--color-surface-dark);
  }

  .home-search-input {
    flex: 1;
    border: none;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    background: transparent;
    color: var(--color-text-primary);
    outline: none;
  }

  .search-btn {
    padding-inline: 1rem;
    min-height: 44px;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: color 0.15s;
    display: flex;
    align-items: center;
  }

  .search-btn:hover { color: var(--color-accent-primary); }

  .search-sub {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .search-sub a {
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  .discourse-list { margin-bottom: 1rem; }

  .view-all-link {
    font-size: 0.875rem;
    color: var(--color-accent-primary);
    text-decoration: none;
    display: inline-block;
    margin-top: 0.5rem;
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-size: 0.925rem;
    font-style: italic;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // ----- Copy quote -----
  const copyBtn = document.getElementById('copy-quote') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const quote = copyBtn.dataset.quote ?? '';
    try {
      await navigator.clipboard.writeText(quote);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
    } catch {
      copyBtn.textContent = 'Copy failed';
    }
  });

  // ----- Random quote -----
  const randomBtn = document.getElementById('random-quote') as HTMLButtonElement | null;
  const quoteEl = document.querySelector<HTMLElement>('#wisdom-quote p');
  const quoteFooter = document.querySelector<HTMLElement>('#wisdom-quote footer a');

  randomBtn?.addEventListener('click', () => {
    const quotes: Array<{ quote: string; slug: string; title: string }> =
      JSON.parse(randomBtn.dataset.quotes ?? '[]');
    if (quotes.length === 0) return;
    const idx = Math.floor(Math.random() * quotes.length);
    const selected = quotes[idx];
    if (quoteEl) quoteEl.textContent = `"${selected.quote}"`;
    if (quoteFooter) {
      quoteFooter.textContent = selected.title;
      quoteFooter.setAttribute('href', `/suhba/${selected.slug}`);
    }
    // Update copy button data
    if (copyBtn) copyBtn.dataset.quote = selected.quote;
  });
</script>
