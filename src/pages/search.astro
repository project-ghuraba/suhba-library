---
// src/pages/search.astro
// Search & Browse page.
// Pagefind keyword search at top; faceted filter panel (with text search) below.

import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PagefindSearch from '../components/search/PagefindSearch.astro';
---

<BaseLayout title="Explore the collection">
  <Header slot="header" />

  <div class="search-page">
    <div class="search-inner">
      <h1 class="page-title">Explore the collection</h1>
      <p class="page-subtitle">Discover suhbas, topics, and insights through search or browsing the collection</p>

      <!-- ── Keyword search (Pagefind) ── -->
      <section class="search-section" aria-label="Keyword search">
        <PagefindSearch />
      </section>

      <!-- ── Browse & Discover ── -->
      <section class="filter-section" aria-labelledby="filter-heading">
        <h2 class="section-label" id="filter-heading">Browse & Discover</h2>

        <!-- Text search — always visible; reads ?q= from URL on load -->
        <label for="filter-text" class="sr-only">Search by keyword</label>
        <input
          type="search"
          id="filter-text"
          class="filter-text-input"
          placeholder="Search by title, speaker, or topic…"
          autocomplete="off"
        />

        <!-- Collapsible filters drawer -->
        <details class="filters-drawer" id="filters-drawer">
          <summary class="filters-toggle">
            <span>Show more filters</span>
            <svg class="filters-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>

          <div class="filter-bar" role="group" aria-label="Filter discourses">
            <div class="filter-row">
              <select id="filter-speaker" class="filter-select" aria-label="Filter by speaker">
                <option value="">All Speakers</option>
              </select>
              <select id="filter-topic" class="filter-select" aria-label="Filter by topic">
                <option value="">All Topics</option>
              </select>
              <select id="filter-country" class="filter-select" aria-label="Filter by country">
                <option value="">All Countries</option>
              </select>
            </div>
            <div class="filter-row filter-row-secondary">
              <label class="date-label">
                Date from
                <div class="date-parts">
                  <input type="number" id="filter-date-from-y" class="filter-date-part filter-date-part--year" placeholder="YYYY" min="1900" max="2099" aria-label="Year from" />
                  <span class="date-sep" aria-hidden="true">/</span>
                  <input type="number" id="filter-date-from-m" class="filter-date-part" placeholder="MM" min="1" max="12" aria-label="Month from" />
                  <span class="date-sep" aria-hidden="true">/</span>
                  <input type="number" id="filter-date-from-d" class="filter-date-part" placeholder="DD" min="1" max="31" aria-label="Day from" />
                </div>
              </label>
              <label class="date-label">
                Date to
                <div class="date-parts">
                  <input type="number" id="filter-date-to-y" class="filter-date-part filter-date-part--year" placeholder="YYYY" min="1900" max="2099" aria-label="Year to" />
                  <span class="date-sep" aria-hidden="true">/</span>
                  <input type="number" id="filter-date-to-m" class="filter-date-part" placeholder="MM" min="1" max="12" aria-label="Month to" />
                  <span class="date-sep" aria-hidden="true">/</span>
                  <input type="number" id="filter-date-to-d" class="filter-date-part" placeholder="DD" min="1" max="31" aria-label="Day to" />
                </div>
              </label>
              <button id="clear-filters" class="clear-btn" type="button" aria-label="Clear all filters">Clear filters</button>
            </div>
          </div>
        </details>

        <!-- Sort controls -->
        <div class="sort-bar" role="group" aria-label="Sort results">
          <span class="sort-label">Sort:</span>
          <button class="sort-btn sort-btn--active" data-sort="newest" type="button">Newest</button>
          <button class="sort-btn" data-sort="oldest" type="button">Oldest</button>
          <button class="sort-btn" data-sort="az" type="button">A–Z</button>
          <button class="sort-btn" data-sort="latest-added" type="button">Latest added</button>
        </div>

        <!-- Per-page controls -->
        <div class="per-page-bar" role="group" aria-label="Results per page">
          <span class="sort-label">Results per page:</span>
          <button class="sort-btn" data-per-page="10" type="button">10</button>
          <button class="sort-btn sort-btn--active" data-per-page="25" type="button">25</button>
          <button class="sort-btn" data-per-page="50" type="button">50</button>
          <button class="sort-btn" data-per-page="0" type="button">All</button>
        </div>

        <!-- Result count -->
        <p class="result-count" id="result-count" aria-live="polite" aria-atomic="true"></p>

        <!-- Results list -->
        <div id="filter-results" aria-live="polite" aria-label="Browse results">
          <p class="loading-state">Loading discourses…</p>
        </div>

        <!-- Pagination controls -->
        <div class="pagination-bar" id="pagination-bar" aria-label="Pagination" hidden>
          <button class="pagination-btn" id="page-prev" type="button" aria-label="Previous page">← Prev</button>
          <span class="pagination-info" id="pagination-info"></span>
          <button class="pagination-btn" id="page-next" type="button" aria-label="Next page">Next →</button>
        </div>
      </section>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .search-page { padding-block: 2rem 4rem; }

  .search-inner {
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .page-title {
    font-size: clamp(1.4rem, 4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.375rem;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0 0 2rem;
    line-height: 1.5;
  }

  .search-section { margin-bottom: 3rem; }

  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    font-weight: 600;
    margin: 0 0 0.875rem;
  }

  /* Text search input above filter bar */
  .filter-text-input {
    width: 100%;
    min-height: 44px;
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-surface-light);
    color: var(--color-text-primary);
    font-size: 1rem;
    font-family: inherit;
    margin-bottom: 0.75rem;
    display: block;
  }

  .filter-text-input::placeholder { color: var(--color-text-secondary); }

  .filter-text-input:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Collapsible filters drawer */
  .filters-drawer {
    margin-bottom: 1rem;
  }

  .filters-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0;
    user-select: none;
    width: fit-content;
    transition: color 0.15s;
  }

  .filters-toggle::-webkit-details-marker { display: none; }

  .filters-toggle:hover { color: var(--color-accent-primary); }

  .filters-chevron {
    transition: transform 0.2s ease;
  }

  details[open] .filters-chevron {
    transform: rotate(180deg);
  }

  .filter-bar {
    background: var(--color-surface-light);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .filter-row-secondary { align-items: flex-end; }

  .filter-select {
    flex: 1 1 180px;
    min-width: 0;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg-light);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    font-family: inherit;
    cursor: pointer;
  }

  .filter-select:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .date-label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .date-parts {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .filter-date-part {
    min-height: 44px;
    padding: 0.5rem 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg-light);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    font-family: inherit;
    width: 52px;
    text-align: center;
    -moz-appearance: textfield;
  }

  .filter-date-part--year { width: 68px; }

  .filter-date-part::-webkit-outer-spin-button,
  .filter-date-part::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .filter-date-part:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .date-sep {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    user-select: none;
  }

  .clear-btn {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    align-self: flex-end;
  }

  .clear-btn:hover { border-color: var(--color-accent-primary); color: var(--color-accent-primary); }

  .sort-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .sort-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-right: 0.25rem;
  }

  .sort-btn {
    min-height: 32px;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .sort-btn--active,
  .sort-btn:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent);
  }

  .per-page-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .pagination-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    justify-content: center;
    flex-wrap: wrap;
  }

  .pagination-btn {
    min-height: 36px;
    padding: 0.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .pagination-btn:hover:not(:disabled) {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .pagination-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .pagination-info {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .result-count {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0 0 1rem;
    min-height: 1.2em;
  }

  /* Result cards rendered by JS — use :global() so Astro's scoped hash doesn't
     prevent styles from applying to dynamically created DOM elements. */
  :global(.result-list) {
    border-top: 1px solid var(--color-border);
  }

  :global(.result-list .discourse-card) {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.result-list .card-link) {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  :global(.result-list .card-title) {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.375rem;
    line-height: 1.35;
    transition: color 0.15s;
  }

  :global(.result-list .card-link:hover .card-title),
  :global(.result-list .card-link:focus-visible .card-title) {
    color: var(--color-accent-primary);
  }

  :global(.result-list .card-meta) {
    font-size: 0.825rem;
    color: var(--color-text-secondary);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
  }

  :global(.result-list .meta-sep) { opacity: 0.4; }

  .empty-state {
    color: var(--color-text-secondary);
    font-style: italic;
    font-size: 0.925rem;
    padding: 2rem 0;
  }

  .loading-state {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    padding: 1rem 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  declare global {
    interface Window {
      zaraz?: { track(event: string, props?: Record<string, unknown>): void };
    }
  }

  interface DiscourseEntry {
    slug: string;
    title: string;
    date: string;
    date_hijri: string;
    date_hijri_est: boolean;
    year: number;
    speaker: string[];
    location_country: string;
    location_city: string | null;
    location_venue: string | null;
    language: string;
    topic: string[];
    transcript_quality: string | null;
    has_youtube: boolean;
    has_quotes: boolean;
    date_added: string;
  }

  let allDiscourses: DiscourseEntry[] = [];
  let activeSort = 'newest';
  let perPage = 25;   // 0 = show all
  let currentPage = 1;

  const inpText      = document.getElementById('filter-text')      as HTMLInputElement;
  const selSpeaker   = document.getElementById('filter-speaker')   as HTMLSelectElement;
  const selTopic     = document.getElementById('filter-topic')     as HTMLSelectElement;
  const selCountry   = document.getElementById('filter-country')   as HTMLSelectElement;
  const inpFromY     = document.getElementById('filter-date-from-y') as HTMLInputElement;
  const inpFromM     = document.getElementById('filter-date-from-m') as HTMLInputElement;
  const inpFromD     = document.getElementById('filter-date-from-d') as HTMLInputElement;
  const inpToY       = document.getElementById('filter-date-to-y')   as HTMLInputElement;
  const inpToM       = document.getElementById('filter-date-to-m')   as HTMLInputElement;
  const inpToD       = document.getElementById('filter-date-to-d')   as HTMLInputElement;
  const btnClear     = document.getElementById('clear-filters')    as HTMLButtonElement;
  const sortBtns     = document.querySelectorAll<HTMLButtonElement>('.sort-btn[data-sort]');
  const perPageBtns  = document.querySelectorAll<HTMLButtonElement>('.sort-btn[data-per-page]');
  const resultsEl    = document.getElementById('filter-results')   as HTMLDivElement;
  const countEl      = document.getElementById('result-count')     as HTMLParagraphElement;
  const paginationBar = document.getElementById('pagination-bar')  as HTMLDivElement;
  const btnPrev      = document.getElementById('page-prev')        as HTMLButtonElement;
  const btnNext      = document.getElementById('page-next')        as HTMLButtonElement;
  const pageInfo     = document.getElementById('pagination-info')  as HTMLSpanElement;

  // Pre-fill inputs from URL params
  const urlParams = new URLSearchParams(window.location.search);
  const urlQ = urlParams.get('q');
  if (urlQ) inpText.value = urlQ;
  const urlSpeaker = urlParams.get('speaker');

  async function loadIndex() {
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error('fetch failed');
      allDiscourses = await res.json() as DiscourseEntry[];
      populateFilters();
      render();
    } catch {
      resultsEl.innerHTML = '<p class="empty-state">Could not load browse index. Make sure the site has been built.</p>';
    }
  }

  function populateFilters() {
    const speakers  = [...new Set(allDiscourses.flatMap(d => d.speaker))].sort();
    const topics    = [...new Set(allDiscourses.flatMap(d => d.topic))].sort();
    const countries = [...new Set(allDiscourses.map(d => d.location_country))].sort();

    appendOptions(selSpeaker, speakers);
    appendOptions(selTopic,   topics);
    appendOptions(selCountry, countries);

    // Apply speaker URL param after options are populated
    if (urlSpeaker) selSpeaker.value = urlSpeaker;
  }

  function appendOptions(sel: HTMLSelectElement, items: string[] | { value: string; label: string }[]) {
    for (const item of items) {
      const opt = document.createElement('option');
      if (typeof item === 'string') { opt.value = item; opt.textContent = item; }
      else { opt.value = item.value; opt.textContent = item.label; }
      sel.appendChild(opt);
    }
  }

  function partialDateKey(y: number|null, m: number|null, d: number|null): string {
    return [
      y !== null ? String(y) : null,
      m !== null ? String(m).padStart(2, '0') : null,
      d !== null ? String(d).padStart(2, '0') : null,
    ].filter((p): p is string => p !== null).join('-');
  }

  function getFilters() {
    return {
      text:      inpText.value.trim().toLowerCase(),
      speaker:   selSpeaker.value,
      topic:     selTopic.value,
      country:   selCountry.value,
      dateFromY: inpFromY.value ? parseInt(inpFromY.value, 10) : null,
      dateFromM: inpFromM.value ? parseInt(inpFromM.value, 10) : null,
      dateFromD: inpFromD.value ? parseInt(inpFromD.value, 10) : null,
      dateToY:   inpToY.value   ? parseInt(inpToY.value,   10) : null,
      dateToM:   inpToM.value   ? parseInt(inpToM.value,   10) : null,
      dateToD:   inpToD.value   ? parseInt(inpToD.value,   10) : null,
    };
  }

  function applyFilters(f: ReturnType<typeof getFilters>) {
    return allDiscourses.filter(d => {
      if (f.text) {
        const t = f.text;
        const matchTitle   = d.title.toLowerCase().includes(t);
        const matchSpeaker = d.speaker.some(s => s.toLowerCase().includes(t));
        const matchTopic   = d.topic.some(tp => tp.toLowerCase().includes(t));
        if (!matchTitle && !matchSpeaker && !matchTopic) return false;
      }
      if (f.speaker && !d.speaker.includes(f.speaker))   return false;
      if (f.topic   && !d.topic.includes(f.topic))       return false;
      if (f.country && d.location_country !== f.country) return false;

      const hasFrom = f.dateFromY !== null || f.dateFromM !== null || f.dateFromD !== null;
      const hasTo   = f.dateToY   !== null || f.dateToM   !== null || f.dateToD   !== null;
      if (hasFrom || hasTo) {
        const [dY, dM, dD] = d.date.split('-').map(Number);
        if (hasFrom) {
          const fromKey = partialDateKey(f.dateFromY, f.dateFromM, f.dateFromD);
          const discKey = partialDateKey(
            f.dateFromY !== null ? dY : null,
            f.dateFromM !== null ? dM : null,
            f.dateFromD !== null ? dD : null,
          );
          if (discKey < fromKey) return false;
        }
        if (hasTo) {
          const toKey   = partialDateKey(f.dateToY, f.dateToM, f.dateToD);
          const discKey = partialDateKey(
            f.dateToY !== null ? dY : null,
            f.dateToM !== null ? dM : null,
            f.dateToD !== null ? dD : null,
          );
          if (discKey > toKey) return false;
        }
      }
      return true;
    });
  }

  function sortResults(list: DiscourseEntry[]) {
    if (activeSort === 'newest') return [...list].sort((a, b) => b.date.localeCompare(a.date));
    if (activeSort === 'oldest') return [...list].sort((a, b) => a.date.localeCompare(b.date));
    if (activeSort === 'latest-added') return [...list].sort((a, b) => b.date_added.localeCompare(a.date_added));
    return [...list].sort((a, b) => a.title.localeCompare(b.title));
  }

  function formatDate(iso: string) {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    });
  }

  function renderCard(d: DiscourseEntry) {
    const article = document.createElement('article');
    article.className = 'discourse-card';

    const link = document.createElement('a');
    link.href = `/suhba/${d.slug}`;
    link.className = 'card-link';

    const titleEl = document.createElement('div');
    titleEl.className = 'card-title';
    titleEl.textContent = d.title;
    link.appendChild(titleEl);
    article.appendChild(link);

    const location = [d.location_city, d.location_country].filter(Boolean).join(', ');

    const meta = document.createElement('p');
    meta.className = 'card-meta';

    const speakerSpan = document.createElement('span');
    speakerSpan.className = 'meta-speaker';
    speakerSpan.textContent = d.speaker.join(', ');

    const sep1 = document.createElement('span');
    sep1.className = 'meta-sep';
    sep1.setAttribute('aria-hidden', 'true');
    sep1.textContent = '·';

    const dateTime = document.createElement('time');
    dateTime.setAttribute('datetime', d.date);
    dateTime.textContent = formatDate(d.date);

    meta.append(speakerSpan, sep1, dateTime);

    if (d.date_hijri) {
      const sep1b = document.createElement('span');
      sep1b.className = 'meta-sep';
      sep1b.setAttribute('aria-hidden', 'true');
      sep1b.textContent = '·';
      const hijriSpan = document.createElement('span');
      hijriSpan.className = 'meta-hijri';
      hijriSpan.textContent = d.date_hijri;
      meta.append(sep1b, hijriSpan);
    }

    if (location) {
      const sep2 = document.createElement('span');
      sep2.className = 'meta-sep';
      sep2.setAttribute('aria-hidden', 'true');
      sep2.textContent = '·';

      const locSpan = document.createElement('span');
      locSpan.textContent = location;

      meta.append(sep2, locSpan);
    }

    article.appendChild(meta);
    return article;
  }

  function render() {
    const f = getFilters();
    const filtered = sortResults(applyFilters(f));
    const n = filtered.length;

    if (n === 0) {
      const f2 = getFilters();
      window.zaraz?.track('zero_results', {
        speaker: f2.speaker || null,
        topic:   f2.topic   || null,
        country: f2.country || null,
      });
      countEl.textContent = 'No discourses match these filters.';
      resultsEl.innerHTML = '<p class="empty-state">No discourses match these filters. Try clearing some filters or broadening your search.</p>';
      paginationBar.hidden = true;
      return;
    }

    // Pagination slice
    const showAll = perPage === 0;
    const totalPages = showAll ? 1 : Math.ceil(n / perPage);
    if (currentPage > totalPages) currentPage = totalPages;

    const start = showAll ? 0 : (currentPage - 1) * perPage;
    const end   = showAll ? n : Math.min(start + perPage, n);
    const pageItems = filtered.slice(start, end);

    // Update result count label
    if (showAll || n <= perPage) {
      countEl.textContent = `${n} discourse${n !== 1 ? 's' : ''}`;
    } else {
      countEl.textContent = `Showing ${start + 1}–${end} of ${n} discourse${n !== 1 ? 's' : ''}`;
    }

    const list = document.createElement('div');
    list.className = 'result-list';
    for (const d of pageItems) list.appendChild(renderCard(d));

    resultsEl.innerHTML = '';
    resultsEl.appendChild(list);

    // Update pagination controls
    if (showAll || totalPages <= 1) {
      paginationBar.hidden = true;
    } else {
      paginationBar.hidden = false;
      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      (btnPrev as HTMLButtonElement).disabled = currentPage === 1;
      (btnNext as HTMLButtonElement).disabled = currentPage === totalPages;
    }
  }

  function resetPage() { currentPage = 1; }

  // Wire up filter events — reset to page 1 on any change
  inpText.addEventListener('input',    () => { resetPage(); render(); });
  selSpeaker.addEventListener('change', () => { resetPage(); render(); });
  selTopic.addEventListener('change',   () => { resetPage(); render(); });
  selCountry.addEventListener('change', () => { resetPage(); render(); });
  [inpFromY, inpFromM, inpFromD, inpToY, inpToM, inpToD].forEach(inp => {
    inp.addEventListener('input', () => { resetPage(); render(); });
  });

  btnClear.addEventListener('click', () => {
    inpText.value    = '';
    selSpeaker.value = '';
    selTopic.value   = '';
    selCountry.value = '';
    inpFromY.value   = '';
    inpFromM.value   = '';
    inpFromD.value   = '';
    inpToY.value     = '';
    inpToM.value     = '';
    inpToD.value     = '';
    resetPage();
    render();
  });

  sortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sortBtns.forEach(b => b.classList.remove('sort-btn--active'));
      btn.classList.add('sort-btn--active');
      activeSort = btn.dataset.sort ?? 'newest';
      resetPage();
      render();
    });
  });

  perPageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      perPageBtns.forEach(b => b.classList.remove('sort-btn--active'));
      btn.classList.add('sort-btn--active');
      perPage = Number(btn.dataset.perPage ?? '25');
      resetPage();
      render();
    });
  });

  btnPrev.addEventListener('click', () => {
    if (currentPage > 1) { currentPage--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });

  btnNext.addEventListener('click', () => {
    currentPage++;
    render();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  loadIndex();
</script>
