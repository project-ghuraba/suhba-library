---
// src/pages/search.astro
// Unified search page — Pagefind full-text search with faceted filters.
// The single text input does full-body Pagefind search; dropdowns narrow
// results using Pagefind's filter API so both work together simultaneously.

import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="Search the collection">
  <Header slot="header" />

  <div class="search-page">
    <div class="search-inner">
      <h1 class="page-title">Search the collection</h1>
      <p class="page-subtitle">Search by keyword and narrow by speaker, topic, location, and date</p>

      <!-- ── Unified search input ── -->
      <label for="filter-text" class="sr-only">Search discourses</label>
      <input
        type="search"
        id="filter-text"
        class="filter-text-input"
        placeholder="Search by keyword, speaker, or topic…"
        autocomplete="off"
      />

      <!-- ── Collapsible filters ── -->
      <details class="filters-drawer" id="filters-drawer">
        <summary class="filters-toggle">
          <span>Show more filters</span>
          <svg class="filters-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>

        <div class="filter-bar" role="group" aria-label="Filter discourses">
          <div class="filter-row">
            <select id="filter-speaker" class="filter-select" aria-label="Filter by speaker">
              <option value="">All Speakers</option>
            </select>
            <select id="filter-topic" class="filter-select" aria-label="Filter by topic">
              <option value="">All Topics</option>
            </select>
            <select id="filter-type" class="filter-select" aria-label="Filter by type">
              <option value="">All Types</option>
            </select>
          </div>
          <div class="filter-row">
            <select id="filter-country" class="filter-select" aria-label="Filter by country">
              <option value="">All Countries</option>
            </select>
            <select id="filter-city" class="filter-select" aria-label="Filter by city">
              <option value="">All Cities</option>
            </select>
            <select id="filter-venue" class="filter-select" aria-label="Filter by venue">
              <option value="">All Venues</option>
            </select>
          </div>
          <div class="filter-row filter-row-secondary">
            <label class="year-label">
              Year from
              <input type="number" id="filter-year-from" class="filter-year-input" placeholder="YYYY" min="1900" max="2099" aria-label="Year from" />
            </label>
            <label class="year-label">
              Year to
              <input type="number" id="filter-year-to" class="filter-year-input" placeholder="YYYY" min="1900" max="2099" aria-label="Year to" />
            </label>
            <button id="clear-filters" class="clear-btn" type="button" aria-label="Clear all filters">Clear filters</button>
          </div>
        </div>
      </details>

      <!-- ── Sort ── -->
      <div class="sort-bar" role="group" aria-label="Sort results">
        <span class="sort-label">Sort:</span>
        <button class="sort-btn sort-btn--active" data-sort="newest" type="button">Newest</button>
        <button class="sort-btn" data-sort="oldest" type="button">Oldest</button>
        <button class="sort-btn" data-sort="az" type="button">A–Z</button>
      </div>

      <!-- ── Per page ── -->
      <div class="per-page-bar" role="group" aria-label="Results per page">
        <span class="sort-label">Per page:</span>
        <button class="sort-btn" data-per-page="10" type="button">10</button>
        <button class="sort-btn sort-btn--active" data-per-page="25" type="button">25</button>
        <button class="sort-btn" data-per-page="50" type="button">50</button>
        <button class="sort-btn" data-per-page="0" type="button">All</button>
      </div>

      <!-- ── Result count ── -->
      <p class="result-count" id="result-count" aria-live="polite" aria-atomic="true"></p>

      <!-- ── Results list ── -->
      <div id="filter-results" aria-live="polite" aria-label="Search results">
        <p class="loading-state">Loading…</p>
      </div>

      <!-- ── Pagination ── -->
      <div class="pagination-bar" id="pagination-bar" aria-label="Pagination" hidden>
        <button class="pagination-btn" id="page-prev" type="button" aria-label="Previous page">← Prev</button>
        <span class="pagination-info" id="pagination-info"></span>
        <button class="pagination-btn" id="page-next" type="button" aria-label="Next page">Next →</button>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .search-page { padding-block: 2rem 4rem; }

  .search-inner {
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .page-title {
    font-size: clamp(1.4rem, 4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.375rem;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .filter-text-input {
    width: 100%;
    min-height: 48px;
    padding: 0.625rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-surface-light);
    color: var(--color-text-primary);
    font-size: 1rem;
    font-family: inherit;
    margin-bottom: 0.875rem;
    display: block;
  }

  .filter-text-input::placeholder { color: var(--color-text-secondary); }

  .filter-text-input:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    border-color: var(--color-accent-primary);
  }

  .filters-drawer { margin-bottom: 1rem; }

  .filters-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0;
    user-select: none;
    width: fit-content;
    transition: color 0.15s;
  }

  .filters-toggle::-webkit-details-marker { display: none; }
  .filters-toggle:hover { color: var(--color-accent-primary); }

  .filters-chevron { transition: transform 0.2s ease; }
  details[open] .filters-chevron { transform: rotate(180deg); }

  .filter-bar {
    background: var(--color-surface-light);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .filter-row-secondary { align-items: flex-end; }

  .filter-select {
    flex: 1 1 180px;
    min-width: 0;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg-light);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    font-family: inherit;
    cursor: pointer;
  }

  .filter-select:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .year-label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .filter-year-input {
    min-height: 44px;
    padding: 0.5rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg-light);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    font-family: inherit;
    width: 90px;
    -moz-appearance: textfield;
  }

  .filter-year-input::-webkit-outer-spin-button,
  .filter-year-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .filter-year-input:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .clear-btn {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    align-self: flex-end;
  }

  .clear-btn:hover { border-color: var(--color-accent-primary); color: var(--color-accent-primary); }

  .sort-bar, .per-page-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .sort-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-right: 0.25rem;
  }

  .sort-btn {
    min-height: 32px;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .sort-btn--active,
  .sort-btn:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent);
  }

  .result-count {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0.25rem 0 1rem;
    min-height: 1.2em;
  }

  .pagination-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    justify-content: center;
    flex-wrap: wrap;
  }

  .pagination-btn {
    min-height: 36px;
    padding: 0.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .pagination-btn:hover:not(:disabled) {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .pagination-btn:disabled { opacity: 0.35; cursor: default; }

  .pagination-info {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-style: italic;
    font-size: 0.925rem;
    padding: 2rem 0;
  }

  .loading-state {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    padding: 1rem 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Result cards — :global() because they're injected by JS */
  :global(.result-list) { border-top: 1px solid var(--color-border); }

  :global(.result-list .discourse-card) {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.result-list .card-link) {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  :global(.result-list .card-title) {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.375rem;
    line-height: 1.35;
    transition: color 0.15s;
  }

  :global(.result-list .card-link:hover .card-title),
  :global(.result-list .card-link:focus-visible .card-title) {
    color: var(--color-accent-primary);
  }

  :global(.result-list .card-excerpt) {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 0.375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.result-list .card-excerpt mark) {
    background: color-mix(in srgb, var(--color-accent-secondary) 28%, transparent);
    color: inherit;
    border-radius: 2px;
    padding-inline: 1px;
  }

  :global(.result-list .card-meta) {
    font-size: 0.825rem;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>

<script>
  declare global {
    interface Window {
      zaraz?: { track(event: string, props?: Record<string, unknown>): void };
    }
  }

  // Minimal Pagefind JS API types
  interface PFResult {
    data(): Promise<PFResultData>;
  }
  interface PFResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    filters: Record<string, string[]>;
    word_count: number;
  }
  interface PFSearch {
    results: PFResult[];
    filters: Record<string, Record<string, number>>;
  }
  interface PFApi {
    init(): Promise<void>;
    filters(): Promise<Record<string, Record<string, number>>>;
    search(query: string | null, opts?: {
      filters?: Record<string, string | string[]>;
      sort?: Record<string, 'asc' | 'desc'>;
    }): Promise<PFSearch>;
  }

  let pf: PFApi | null = null;
  let activeSort    = 'newest';
  let perPage       = 25;
  let currentPage   = 1;
  let currentResults: PFResult[] = [];
  let allFilterData: Record<string, Record<string, number>> = {};

  const inpText     = document.getElementById('filter-text')      as HTMLInputElement;
  const selSpeaker  = document.getElementById('filter-speaker')   as HTMLSelectElement;
  const selTopic    = document.getElementById('filter-topic')     as HTMLSelectElement;
  const selType     = document.getElementById('filter-type')      as HTMLSelectElement;
  const selCountry  = document.getElementById('filter-country')   as HTMLSelectElement;
  const selCity     = document.getElementById('filter-city')      as HTMLSelectElement;
  const selVenue    = document.getElementById('filter-venue')     as HTMLSelectElement;
  const inpFromY    = document.getElementById('filter-year-from') as HTMLInputElement;
  const inpToY      = document.getElementById('filter-year-to')   as HTMLInputElement;
  const btnClear    = document.getElementById('clear-filters')    as HTMLButtonElement;
  const sortBtns    = document.querySelectorAll<HTMLButtonElement>('.sort-btn[data-sort]');
  const perPageBtns = document.querySelectorAll<HTMLButtonElement>('.sort-btn[data-per-page]');
  const resultsEl   = document.getElementById('filter-results')   as HTMLDivElement;
  const countEl     = document.getElementById('result-count')     as HTMLParagraphElement;
  const pagBar      = document.getElementById('pagination-bar')   as HTMLDivElement;
  const btnPrev     = document.getElementById('page-prev')        as HTMLButtonElement;
  const btnNext     = document.getElementById('page-next')        as HTMLButtonElement;
  const pageInfo    = document.getElementById('pagination-info')  as HTMLSpanElement;

  // Pre-fill from URL params (home page search hands off via ?q=)
  const urlParams  = new URLSearchParams(window.location.search);
  const urlQ       = urlParams.get('q');
  if (urlQ) inpText.value = urlQ;
  const urlSpeaker = urlParams.get('speaker');

  // ── Init ──────────────────────────────────────────────────────────────────

  async function init() {
    try {
      // @ts-ignore: /pagefind/pagefind.js is a post-build artifact with no type declarations
      pf = await import(/* @vite-ignore */ '/pagefind/pagefind.js') as PFApi;
      await pf.init();
      allFilterData = await pf.filters();
      populateDropdowns(allFilterData);
      if (urlSpeaker) selSpeaker.value = urlSpeaker;
      await runSearch();
    } catch {
      resultsEl.innerHTML = '<p class="empty-state">Search is unavailable in dev mode — run <code>pnpm build</code> first.</p>';
      countEl.textContent = '';
    }
  }

  // ── Dropdown population ───────────────────────────────────────────────────

  function appendOptions(sel: HTMLSelectElement, keys: string[]) {
    for (const k of keys) {
      const opt = document.createElement('option');
      opt.value = k;
      opt.textContent = k;
      sel.appendChild(opt);
    }
  }

  function populateDropdowns(data: Record<string, Record<string, number>>) {
    appendOptions(selSpeaker, Object.keys(data.speaker ?? {}).sort());
    appendOptions(selTopic,   Object.keys(data.topic   ?? {}).sort());
    appendOptions(selType,    Object.keys(data.type    ?? {}).sort());
    appendOptions(selCountry, Object.keys(data.country ?? {}).sort());
    appendOptions(selCity,    Object.keys(data.city    ?? {}).sort());
    appendOptions(selVenue,   Object.keys(data.venue   ?? {}).sort());
  }

  async function refreshCityVenue() {
    if (!pf) return;
    const country = selCountry.value;
    const city    = selCity.value;

    // Get available cities for selected country
    const citySearch = await pf.search(null, { filters: country ? { country } : {} });
    const availCities = Object.keys(citySearch.filters.city ?? {}).sort();
    const prevCity = selCity.value;
    selCity.innerHTML = '<option value="">All Cities</option>';
    appendOptions(selCity, availCities);
    if (availCities.includes(prevCity)) selCity.value = prevCity;

    // Get available venues for selected country + city
    const venueFilters: Record<string, string> = {};
    if (country) venueFilters.country = country;
    if (city && availCities.includes(city)) venueFilters.city = city;
    const venueSearch = await pf.search(null, { filters: venueFilters });
    const availVenues = Object.keys(venueSearch.filters.venue ?? {}).sort();
    const prevVenue = selVenue.value;
    selVenue.innerHTML = '<option value="">All Venues</option>';
    appendOptions(selVenue, availVenues);
    if (availVenues.includes(prevVenue)) selVenue.value = prevVenue;
  }

  // ── Search ────────────────────────────────────────────────────────────────

  function buildSort(): Record<string, 'asc' | 'desc'> | undefined {
    if (activeSort === 'newest') return { date: 'desc' };
    if (activeSort === 'oldest') return { date: 'asc' };
    if (activeSort === 'az')     return { title: 'asc' };
    return undefined;
  }

  function buildFilters(): Record<string, string | string[]> {
    const f: Record<string, string | string[]> = {};
    if (selSpeaker.value) f.speaker = selSpeaker.value;
    if (selTopic.value)   f.topic   = selTopic.value;
    if (selType.value)    f.type    = selType.value;
    if (selCountry.value) f.country = selCountry.value;
    if (selCity.value)    f.city    = selCity.value;
    if (selVenue.value)   f.venue   = selVenue.value;

    const fromY = inpFromY.value ? parseInt(inpFromY.value, 10) : null;
    const toY   = inpToY.value   ? parseInt(inpToY.value,   10) : null;
    if (fromY !== null || toY !== null) {
      const lo = fromY ?? 1900;
      const hi = toY   ?? new Date().getFullYear();
      const years: string[] = [];
      for (let y = lo; y <= hi; y++) years.push(String(y));
      f.year = years;
    }
    return f;
  }

  async function runSearch() {
    if (!pf) return;
    countEl.textContent = 'Searching…';
    resultsEl.innerHTML = '<p class="loading-state">Searching…</p>';
    pagBar.hidden = true;

    try {
      const query = inpText.value.trim() || null;
      const search = await pf.search(
        query,
        { filters: buildFilters(), sort: buildSort() },
      );
      currentResults = search.results;
      currentPage    = 1;
      await renderPage();
    } catch {
      resultsEl.innerHTML = '<p class="empty-state">Search failed — please try again.</p>';
      countEl.textContent = '';
    }
  }

  // ── Render ────────────────────────────────────────────────────────────────

  function formatDate(iso: string) {
    if (!iso) return '';
    const [y, m, d] = iso.split('-').map(Number);
    if (y === 1900) return 'Undated';
    return new Date(y, m - 1, d).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    });
  }

  async function renderPage() {
    const n = currentResults.length;

    if (n === 0) {
      window.zaraz?.track('zero_results', {
        speaker: selSpeaker.value || null,
        topic:   selTopic.value   || null,
        country: selCountry.value || null,
      });
      countEl.textContent = 'No discourses found.';
      resultsEl.innerHTML = '<p class="empty-state">No results match. Try clearing some filters or changing your search.</p>';
      pagBar.hidden = true;
      return;
    }

    const showAll    = perPage === 0;
    const totalPages = showAll ? 1 : Math.ceil(n / perPage);
    if (currentPage > totalPages) currentPage = totalPages;

    const start     = showAll ? 0 : (currentPage - 1) * perPage;
    const end       = showAll ? n : Math.min(start + perPage, n);
    const pageSlice = currentResults.slice(start, end);

    // Load data only for the visible page slice
    const dataArr = await Promise.all(pageSlice.map(r => r.data()));

    // Result count label
    if (showAll || n <= perPage) {
      countEl.textContent = `${n} discourse${n !== 1 ? 's' : ''}`;
    } else {
      countEl.textContent = `Showing ${start + 1}–${end} of ${n} discourse${n !== 1 ? 's' : ''}`;
    }

    const list = document.createElement('div');
    list.className = 'result-list';

    for (const d of dataArr) {
      const slug     = d.meta.slug || d.url.replace(/^\/suhba\//, '').replace(/\/$/, '');
      const title    = d.meta.title   ?? 'Untitled';
      const date     = formatDate(d.meta.date ?? '');
      const hijri    = d.meta.hijri   ?? '';
      const speaker  = d.meta.speaker ?? '';
      const country  = d.meta.country ?? '';
      const city     = d.meta.city    ?? '';
      const location = [city, country].filter(Boolean).join(', ');

      const article = document.createElement('article');
      article.className = 'discourse-card';

      const link = document.createElement('a');
      link.href      = `/suhba/${slug}`;
      link.className = 'card-link';

      const titleEl = document.createElement('div');
      titleEl.className   = 'card-title';
      titleEl.textContent = title;
      link.appendChild(titleEl);

      if (d.excerpt) {
        const excerptEl = document.createElement('p');
        excerptEl.className = 'card-excerpt';
        excerptEl.innerHTML = d.excerpt; // contains <mark> highlights from Pagefind
        link.appendChild(excerptEl);
      }

      article.appendChild(link);

      const metaParts = [speaker, date, hijri, location].filter(Boolean);
      const metaEl = document.createElement('p');
      metaEl.className   = 'card-meta';
      metaEl.textContent = metaParts.join(' · ');
      article.appendChild(metaEl);

      list.appendChild(article);
    }

    resultsEl.innerHTML = '';
    resultsEl.appendChild(list);

    // Pagination controls
    if (showAll || totalPages <= 1) {
      pagBar.hidden = true;
    } else {
      pagBar.hidden = false;
      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      btnPrev.disabled = currentPage === 1;
      btnNext.disabled = currentPage === totalPages;
    }
  }

  // ── Event wiring ──────────────────────────────────────────────────────────

  let debounce: ReturnType<typeof setTimeout>;
  function debounced() {
    clearTimeout(debounce);
    debounce = setTimeout(() => { currentPage = 1; runSearch(); }, 300);
  }

  inpText.addEventListener('input', debounced);

  selCountry.addEventListener('change', async () => {
    selCity.value  = '';
    selVenue.value = '';
    await refreshCityVenue();
    currentPage = 1;
    runSearch();
  });

  selCity.addEventListener('change', async () => {
    selVenue.value = '';
    await refreshCityVenue();
    currentPage = 1;
    runSearch();
  });

  [selSpeaker, selTopic, selType, selVenue].forEach(sel => {
    sel.addEventListener('change', () => { currentPage = 1; runSearch(); });
  });

  [inpFromY, inpToY].forEach(inp => {
    inp.addEventListener('input', debounced);
  });

  btnClear.addEventListener('click', async () => {
    inpText.value    = '';
    selSpeaker.value = '';
    selTopic.value   = '';
    selType.value    = '';
    selCountry.value = '';
    selCity.value    = '';
    selVenue.value   = '';
    inpFromY.value   = '';
    inpToY.value     = '';
    // Restore full city/venue lists
    selCity.innerHTML  = '<option value="">All Cities</option>';
    selVenue.innerHTML = '<option value="">All Venues</option>';
    appendOptions(selCity,  Object.keys(allFilterData.city  ?? {}).sort());
    appendOptions(selVenue, Object.keys(allFilterData.venue ?? {}).sort());
    currentPage = 1;
    runSearch();
  });

  sortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sortBtns.forEach(b => b.classList.remove('sort-btn--active'));
      btn.classList.add('sort-btn--active');
      activeSort  = btn.dataset.sort ?? 'newest';
      currentPage = 1;
      runSearch();
    });
  });

  perPageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      perPageBtns.forEach(b => b.classList.remove('sort-btn--active'));
      btn.classList.add('sort-btn--active');
      perPage     = Number(btn.dataset.perPage ?? '25');
      currentPage = 1;
      renderPage();
    });
  });

  btnPrev.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderPage();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  btnNext.addEventListener('click', () => {
    currentPage++;
    renderPage();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  init();
</script>
