---
// src/pages/speakers/[speaker].astro
// Individual speaker page — portrait, bio, quotes, discourse list.

import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import DiscourseCard from '../../components/discourse/DiscourseCard.astro';
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

export async function getStaticPaths() {
  // Defined inside getStaticPaths — Astro 5 bundles this function separately
  // and loses access to module-scope declarations.
  function nameToSlug(name: string) {
    return name
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '');
  }

  const discourses = await getCollection('discourses', ({ data }) => data.status === 'published');

  const speakerNames = new Set<string>();
  for (const d of discourses) {
    for (const s of d.data.speaker) speakerNames.add(s);
  }

  return Array.from(speakerNames).map(name => ({
    params: { speaker: nameToSlug(name) },
    props: { speakerName: name },
  }));
}

const { speakerName } = Astro.props;
const { speaker: speakerSlug } = Astro.params;

// Load discourses for this speaker
const allDiscourses = await getCollection('discourses', ({ data }) => data.status === 'published');
const speakerDiscourses = allDiscourses
  .filter(d => d.data.speaker.includes(speakerName))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

interface SpeakerFrontmatter {
  name_full?: string;
  image?: string;
  image_avatar?: string;
  selected_quotes?: string[];
  links?: Array<{ label: string; url: string }>;
}

function parseSpeakerFile(raw: string): { fm: SpeakerFrontmatter; body: string } {
  const fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n?/);
  if (!fmMatch) return { fm: {}, body: raw.trim() };
  const fmStr = fmMatch[1];
  const body = raw.slice(fmMatch[0].length).trim();
  const fm: SpeakerFrontmatter = {};

  const nameFullM = fmStr.match(/^name_full:\s*"?([^"\n]+)"?\s*$/m);
  if (nameFullM) fm.name_full = nameFullM[1].trim();

  const imageM = fmStr.match(/^image:\s*"?([^"\n]+)"?\s*$/m);
  if (imageM) fm.image = imageM[1].trim();

  const avatarM = fmStr.match(/^image_avatar:\s*"?([^"\n]+)"?\s*$/m);
  if (avatarM) fm.image_avatar = avatarM[1].trim();

  const sqSection = fmStr.match(/^selected_quotes:\s*\n((?:[ \t]+-[ \t]+.*\n?)*)/m);
  if (sqSection) {
    fm.selected_quotes = [...sqSection[1].matchAll(/^[ \t]+-[ \t]+"?(.*?)"?\s*$/gm)].map(m => m[1]);
  }

  const linksSection = fmStr.match(/^links:\s*\n([\s\S]*?)(?=\n\S|$)/m);
  if (linksSection) {
    const blocks = linksSection[1].split(/(?=[ \t]+-[ \t])/);
    fm.links = blocks.map(block => {
      const lM = block.match(/label:\s*"?([^"\n]+)"?/);
      const uM = block.match(/url:\s*"?([^"\n]+)"?/);
      return lM && uM ? { label: lM[1].trim(), url: uM[1].trim() } : null;
    }).filter((l): l is { label: string; url: string } => l !== null);
  }

  return { fm, body };
}

// Load speaker data file (frontmatter + bio)
let bioHtml: string | null = null;
let speakerFm: SpeakerFrontmatter = {};
try {
  const bioPath = join(process.cwd(), 'src', 'data', 'speakers', `${speakerSlug}.md`);
  const raw = await readFile(bioPath, 'utf-8');
  const { fm, body } = parseSpeakerFile(raw);
  speakerFm = fm;
  if (body) {
    bioHtml = body
      .split(/\n{2,}/)
      .map(p => `<p>${p.trim()}</p>`)
      .join('\n');
  }
} catch {
  // No bio file yet — that's fine
}

// Notable quotes: prefer selected_quotes from speaker file, else fall back to discourse quotes_verified
const speakerQuotes: string[] = speakerFm.selected_quotes?.length
  ? speakerFm.selected_quotes
  : (() => {
      const qs: string[] = [];
      for (const d of speakerDiscourses) {
        for (const q of d.data.quotes_verified ?? []) qs.push(q);
      }
      return qs;
    })();

const discourseCount = speakerDiscourses.length;
---

<BaseLayout title={speakerFm.name_full ?? speakerName}>
  <Header slot="header" />

  {speakerFm.image && (
    <div class="speaker-hero">
      <img src={speakerFm.image} alt={`${speakerName} — hero image`} class="speaker-hero-img" />
    </div>
  )}

  <div class="speaker-page">
    <div class="speaker-inner">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/speakers" class="breadcrumb-link">← All Speakers</a>
      </nav>

      <!-- Speaker header -->
      <header class="speaker-header">
        {speakerFm.image_avatar ? (
          <img
            src={speakerFm.image_avatar}
            alt={speakerName}
            class="speaker-avatar-img"
          />
        ) : (
          <div class="speaker-avatar-lg" aria-hidden="true">
            {speakerName.split(' ').map((w: string) => w[0]).slice(0, 2).join('')}
          </div>
        )}
        <div>
          <h1 class="speaker-name">{speakerName}</h1>
          {speakerFm.name_full && (
            <p class="speaker-name-full">{speakerFm.name_full}</p>
          )}
          <p class="speaker-meta">
            {discourseCount} discourse{discourseCount !== 1 ? 's' : ''} in the archive
          </p>
        </div>
      </header>

      <!-- Biography -->
      {bioHtml ? (
        <section class="speaker-bio" aria-labelledby="bio-heading">
          <h2 class="section-heading" id="bio-heading">Biography</h2>
          <div class="bio-body" set:html={bioHtml} />
        </section>
      ) : (
        <section class="speaker-bio">
          <p class="empty-state">
            No biography authored yet. Create <code>src/data/speakers/{speakerSlug}.md</code> to add one.
          </p>
        </section>
      )}

      <!-- Notable quotes -->
      {speakerQuotes.length > 0 && (
        <section class="speaker-quotes" aria-labelledby="quotes-heading">
          <h2 class="section-heading" id="quotes-heading">Notable Quotes</h2>
          <div class="quotes-list">
            {speakerQuotes.slice(0, 6).map(q => (
              <blockquote class="speaker-quote">
                <p>"{q}"</p>
              </blockquote>
            ))}
          </div>
        </section>
      )}

      <!-- Helpful links -->
      {speakerFm.links && speakerFm.links.length > 0 && (
        <section class="speaker-links" aria-labelledby="links-heading">
          <h2 class="section-heading" id="links-heading">Helpful Links</h2>
          <ul class="links-list">
            {speakerFm.links.map(link => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="helpful-link">
                  {link.label}
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="link-arrow">
                    <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Discourse list -->
      <section aria-labelledby="discourses-heading">
        <h2 class="section-heading" id="discourses-heading">All Discourses</h2>
        {speakerDiscourses.length > 0 ? (
          <div class="discourse-list">
            {speakerDiscourses.map(d => (
              <DiscourseCard
                title={d.data.title}
                slug={d.data.slug}
                date={d.data.date}
                dateHijri={d.data.date_hijri}
                speakers={d.data.speaker}
                locationCountry={d.data.location_country}
                locationCity={d.data.location_city}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">No published discourses found for this speaker.</p>
        )}
      </section>

    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Hero image */
  .speaker-hero {
    width: 100%;
    max-height: 320px;
    overflow: hidden;
  }

  .speaker-hero-img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .speaker-page { padding-block: 2rem 4rem; }

  .speaker-inner {
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .breadcrumb { margin-bottom: 1.25rem; }

  .breadcrumb-link {
    font-size: 0.875rem;
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  .breadcrumb-link:hover { opacity: 0.75; }

  .speaker-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .speaker-avatar-lg {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent-primary) 15%, transparent);
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Avatar image (when photo provided) */
  .speaker-avatar-img {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--color-border);
  }

  .speaker-name {
    font-size: clamp(1.4rem, 4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.15rem;
  }

  .speaker-name-full {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0 0 0.25rem;
  }

  .speaker-meta {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .section-heading {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .speaker-bio { margin-bottom: 0; }

  .bio-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    max-width: var(--prose-width);
  }

  .bio-body p { margin-block: 0.875em; }

  .quotes-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .speaker-quote {
    margin: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-accent-secondary);
    background: color-mix(in srgb, var(--color-accent-secondary) 5%, transparent);
    border-radius: 0 0.375rem 0.375rem 0;
  }

  .speaker-quote p {
    font-family: var(--font-serif);
    font-size: 0.975rem;
    line-height: 1.7;
    margin: 0;
    color: var(--color-text-primary);
  }

  /* Helpful links */
  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .helpful-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-accent-primary);
    text-decoration: none;
    font-size: 0.95rem;
    transition: opacity 0.15s;
  }

  .helpful-link:hover { text-decoration: underline; }

  .link-arrow { flex-shrink: 0; }

  .empty-state {
    color: var(--color-text-secondary);
    font-style: italic;
    font-size: 0.925rem;
  }
</style>
