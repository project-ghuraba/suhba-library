---
// src/pages/speakers/index.astro
// Speaker biographies index — vertical list.

import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

// Count discourses per speaker
const discourses = await getCollection('discourses', ({ data }) => data.status === 'published');

const speakerCountMap = new Map<string, number>();
for (const d of discourses) {
  for (const s of d.data.speaker) {
    speakerCountMap.set(s, (speakerCountMap.get(s) ?? 0) + 1);
  }
}

function nameToSlug(name: string) {
  return name
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '');
}

// Build speaker list — sorted by discourse count desc
const speakers = Array.from(speakerCountMap.entries())
  .map(([name, count]) => ({ name, count, slug: nameToSlug(name) }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="Speakers">
  <Header slot="header" />

  <div class="speakers-page">
    <div class="speakers-inner">
      <header class="page-header">
        <h1 class="page-title">Speakers</h1>
        <p class="page-subtitle">{speakers.length} speaker{speakers.length !== 1 ? 's' : ''} in the archive</p>
      </header>

      <div class="speakers-list">
        {speakers.map(({ name, count, slug }) => (
          <a href={`/speakers/${slug}`} class="speaker-row">
            <div class="speaker-avatar" aria-hidden="true">
              {name.split(' ').map(w => w[0]).slice(0, 2).join('')}
            </div>
            <div class="speaker-info">
              <p class="speaker-name">{name}</p>
              <p class="speaker-count">{count} discourse{count !== 1 ? 's' : ''}</p>
            </div>
            <svg class="speaker-chevron" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}
      </div>

      {speakers.length === 0 && (
        <p class="empty-state">No speakers found. Add discourses with <code>speaker</code> frontmatter.</p>
      )}
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .speakers-page { padding-block: 2rem 4rem; }

  .speakers-inner {
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .page-header { margin-bottom: 2rem; }

  .page-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .speakers-list {
    display: flex;
    flex-direction: column;
  }

  .speaker-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .speaker-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .speaker-row:hover,
  .speaker-row:focus-visible {
    background: color-mix(in srgb, var(--color-accent-primary) 4%, transparent);
  }

  .speaker-avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent-primary) 15%, transparent);
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  .speaker-info {
    flex: 1;
    min-width: 0;
  }

  .speaker-name {
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0 0 0.2rem;
    line-height: 1.3;
  }

  .speaker-count {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .speaker-chevron {
    color: var(--color-text-secondary);
    flex-shrink: 0;
    opacity: 0.5;
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-style: italic;
    font-size: 0.925rem;
  }
</style>
