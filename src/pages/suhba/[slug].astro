---
// src/pages/suhba/[slug].astro
// Individual discourse page.

import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import DiscourseCard from '../../components/discourse/DiscourseCard.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { toHijri } from 'hijri-converter';

const HIJRI_MONTHS = [
  'Muharram', 'Safar', 'Rabi al-Awwal', 'Rabi al-Thani',
  'Jumada al-Awwal', 'Jumada al-Thani', 'Rajab', "Sha'ban",
  'Ramadan', 'Shawwal', 'Dhul Qadah', 'Dhul Hijjah',
];

export async function getStaticPaths() {
  const discourses = await getCollection('discourses', ({ data }) => data.status === 'published');
  return discourses.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

// Reading time — 200 wpm
const wordCount = entry.body?.split(/\s+/).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Gregorian date display
const gregorianDate = data.date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});

// Islamic date — manual or computed from Gregorian
const hijriDisplay = data.date_hijri ?? (() => {
  const { hy, hm, hd } = toHijri(data.date.getFullYear(), data.date.getMonth() + 1, data.date.getDate());
  return `${hd} ${HIJRI_MONTHS[hm - 1]} ${hy}`;
})();
const hijriIsEstimated = !data.date_hijri;

// Location display
const locationParts = [data.location_venue, data.location_city, data.location_country]
  .filter(Boolean).join(', ');

const speakerList = data.speaker_full ?? data.speaker.join(' & ');

// Related discourses — share at least one topic
const allDiscourses = await getCollection('discourses', ({ data }) => data.status === 'published');
const related = allDiscourses
  .filter(d => d.data.slug !== data.slug)
  .map(d => ({
    d,
    shared: d.data.topic.filter(t => data.topic.includes(t)).length,
  }))
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 3)
  .map(({ d }) => d);

// OG image
const ogImage = data.image ?? 'https://r2.suhbalibrary.org/og-default.jpg';

// Share URLs
const canonicalUrl = new URL(`/suhba/${data.slug}`, Astro.site).toString();
const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(data.title);
const firstQuote = data.quotes_verified?.[0] ?? '';
const emailBody = encodeURIComponent(
  firstQuote ? `"${firstQuote}"\n\n${canonicalUrl}` : canonicalUrl
);

// JSON-LD
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  datePublished: data.date.toISOString().split('T')[0],
  dateModified: data.edited_at
    ? (data.edited_at as Date).toISOString().split('T')[0]
    : data.date.toISOString().split('T')[0],
  author: data.speaker.map(name => ({ '@type': 'Person', name })),
  publisher: {
    '@type': 'Organization',
    name: 'The Suhba Library',
    url: Astro.site?.toString(),
  },
  inLanguage: data.language,
  image: ogImage,
  url: canonicalUrl,
  keywords: data.topic.join(', '),
};

// Language/direction
const isRtl = data.language === 'ar' || data.language === 'ur' || data.language === 'fa';
---

<BaseLayout
  title={data.title}
  description={firstQuote || `A spiritual discourse by ${speakerList}.`}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
  lang={data.language}
  dir={isRtl ? 'rtl' : 'ltr'}
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <article class="discourse-page">

    <!-- Header image — full natural height, no crop -->
    <div class="discourse-hero">
      <img
        src={ogImage}
        alt={`Header image for: ${data.title}`}
        class="discourse-hero-img"
        loading="eager"
      />
    </div>

    <div class="discourse-body-wrapper">

      <!-- Title block -->
      <header class="discourse-header">
        <h1 class="discourse-title">{data.title}</h1>

        <div class="discourse-meta">
          <span class="meta-speaker">{speakerList}</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <time datetime={data.date.toISOString().split('T')[0]}>{gregorianDate}</time>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span title={hijriIsEstimated ? 'Islamic date computed from Gregorian' : undefined}>
            {hijriDisplay}{hijriIsEstimated ? ' (est.)' : ''}
          </span>
          {locationParts && (
            <>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span>{locationParts}</span>
            </>
          )}
        </div>

        <div class="discourse-badges">
          <span class="reading-time" aria-label={`Estimated reading time: ${readingMinutes} minutes`}>
            {readingMinutes} min read
          </span>
          {data.edited_at && (
            <span class="edited-notice" aria-label="This discourse was updated">
              Last updated {(data.edited_at as Date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          )}
        </div>

        <!-- Watch on YouTube -->
        {data.youtube_url && (
          <div class="youtube-row">
            <a
              href={data.youtube_url}
              class="youtube-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Watch "${data.title}" on YouTube (opens in new tab)`}
              data-cf-event="youtube_click"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21.8 8s-.2-1.4-.8-2c-.8-.8-1.6-.8-2-.9C16.2 5 12 5 12 5s-4.2 0-7 .1c-.4.1-1.2.1-2 .9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.2.8C6.8 19 12 19 12 19s4.2 0 7-.2c.4-.1 1.2-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.8 14.5v-5.5l5.4 2.8-5.4 2.7z"/>
              </svg>
              Watch on YouTube
            </a>
            <span class="youtube-alt">or read the suhba below</span>
          </div>
        )}
      </header>

      <!-- Discourse body -->
      <div class="prose" data-pagefind-body>
        <Content />
      </div>

      <!-- Topic pills — before share bar -->
      <div class="discourse-topics" aria-label="Topics">
        {data.topic.map(t => (
          <a href={`/topics/${t.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '-').replace(/-{2,}/g, '-').replace(/^-|-$/g, '')}`} class="topic-pill">
            {t}
          </a>
        ))}
      </div>

      <!-- Share bar -->
      <aside class="share-bar" aria-label="Share this discourse">
        <p class="share-label">Share</p>
        <div class="share-icons">
          <!-- WhatsApp -->
          <a
            href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on WhatsApp"
            data-platform="whatsapp"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>

          <!-- X / Twitter -->
          <a
            href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on X / Twitter"
            data-platform="twitter"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.63L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
            </svg>
          </a>

          <!-- Telegram -->
          <a
            href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Telegram"
            data-platform="telegram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Facebook"
            data-platform="facebook"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LinkedIn"
            data-platform="linkedin"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href={`mailto:?subject=${encodedTitle}&body=${emailBody}`}
            class="share-icon"
            aria-label="Share via Email"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 7 10-7" stroke-linecap="round"/>
            </svg>
          </a>

          <!-- Copy Link -->
          <button
            id="copy-link"
            class="share-icon"
            aria-label="Copy link to clipboard"
            data-url={canonicalUrl}
          >
            <svg id="copy-link-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
          </button>
        </div>
      </aside>

      <!-- Related Suhbas -->
      {related.length > 0 && (
        <section class="related-suhbas" aria-labelledby="related-heading">
          <h2 class="related-heading" id="related-heading">Related Suhbas</h2>
          <div class="related-list">
            {related.map(d => (
              <DiscourseCard
                title={d.data.title}
                slug={d.data.slug}
                date={d.data.date}
                dateHijri={d.data.date_hijri}
                speakers={d.data.speaker}
                locationCountry={d.data.location_country}
                locationCity={d.data.location_city}
              />
            ))}
          </div>
        </section>
      )}

    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .discourse-page { padding-bottom: 3rem; }

  /* Hero image — full bleed on mobile, body-width on desktop */
  .discourse-hero {
    width: 100%;
    background: var(--color-bg-light);
  }

  .discourse-hero-img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 520px;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .discourse-hero {
      max-width: 850px;
      margin-inline: auto;
      padding-inline: 1rem;
    }
    .discourse-hero-img {
      border-radius: 0.375rem;
    }
  }

  .discourse-body-wrapper {
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
    padding-top: 2rem;
  }

  .discourse-header { margin-bottom: 2rem; }

  .discourse-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .discourse-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .meta-sep { opacity: 0.4; }

  .discourse-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .reading-time {
    font-size: 0.775rem;
    color: var(--color-text-secondary);
    padding: 0.2rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .edited-notice {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .youtube-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .youtube-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.875rem;
    min-height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }

  .youtube-link:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .youtube-alt {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  /* Prose lives at max 70ch */
  .prose {
    max-width: var(--prose-width);
  }

  /* Topic pills — before share bar */
  .discourse-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 2.5rem 0;
  }

  .topic-pill {
    font-size: 0.8rem;
    padding: 0.35rem 0.875rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-primary) 10%, transparent);
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: background 0.15s;
  }

  .topic-pill:hover { background: color-mix(in srgb, var(--color-accent-primary) 18%, transparent); }

  /* Share bar */
  .share-bar {
    margin-block: 1.5rem 2.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .share-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    margin: 0 0 0.75rem;
  }

  .share-icons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .share-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-text-secondary);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    font-family: inherit;
  }

  .share-icon:hover,
  .share-icon:focus-visible {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  /* Related */
  .related-suhbas { border-top: 1px solid var(--color-border); padding-top: 2rem; }
  .related-heading { font-size: 1rem; font-weight: 600; margin: 0 0 0.5rem; }
</style>

<script>
  declare global {
    interface Window {
      zaraz?: { track(event: string, props?: Record<string, unknown>): void };
    }
  }

  // ----- Copy link -----
  const copyLinkBtn = document.getElementById('copy-link') as HTMLButtonElement | null;
  const copyLinkIcon = document.getElementById('copy-link-icon') as SVGElement | null;

  copyLinkBtn?.addEventListener('click', async () => {
    const url = copyLinkBtn.dataset.url ?? window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      window.zaraz?.track('share_click', { platform: 'copy_link' });
      if (copyLinkIcon) {
        copyLinkIcon.innerHTML = '<path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>';
      }
      setTimeout(() => {
        if (copyLinkIcon) {
          copyLinkIcon.innerHTML = '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>';
        }
      }, 2000);
    } catch {
      // silent fail
    }
  });

  // ----- Share click tracking -----
  document.querySelectorAll<HTMLElement>('.share-icon[data-platform]').forEach(el => {
    el.addEventListener('click', () => {
      window.zaraz?.track('share_click', { platform: el.dataset.platform });
    });
  });

  // ----- YouTube click tracking -----
  document.querySelector('[data-cf-event="youtube_click"]')?.addEventListener('click', () => {
    window.zaraz?.track('youtube_click');
  });

  // ----- Scroll depth tracking -----
  const depthMilestones = [25, 50, 75, 100];
  const depthFired = new Set<number>();
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY + window.innerHeight;
    const total = document.documentElement.scrollHeight;
    const pct = Math.round((scrolled / total) * 100);
    for (const m of depthMilestones) {
      if (pct >= m && !depthFired.has(m)) {
        depthFired.add(m);
        window.zaraz?.track('scroll_depth', { percent: m });
      }
    }
  }, { passive: true });
</script>
