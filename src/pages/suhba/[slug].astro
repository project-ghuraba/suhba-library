---
// src/pages/suhba/[slug].astro
// Individual discourse page.

import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import DiscourseCard from '../../components/discourse/DiscourseCard.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const discourses = await getCollection('discourses', ({ data }) => data.status === 'published');
  return discourses.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

// Reading time — 200 wpm
const wordCount = entry.body?.split(/\s+/).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Gregorian date display
const gregorianDate = data.date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});

// Islamic date — manual or estimated
const hijriDisplay = data.date_hijri ?? null;

// Location display
const locationParts = [data.location_venue, data.location_city, data.location_country]
  .filter(Boolean).join(', ');

const speakerList = data.speaker.join(' & ');

// Related discourses — share at least one topic
// Precomputed at build time here (simple approach for v1)
const allDiscourses = await getCollection('discourses', ({ data }) => data.status === 'published');
const related = allDiscourses
  .filter(d => d.data.slug !== data.slug)
  .map(d => ({
    d,
    shared: d.data.topic.filter(t => data.topic.includes(t)).length,
  }))
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 3)
  .map(({ d }) => d);

// OG image
const ogImage = data.image ?? 'https://r2.suhbalibrary.org/og-default.jpg';

// Share URLs
const canonicalUrl = new URL(`/suhba/${data.slug}`, Astro.site).toString();
const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(data.title);
const firstQuote = data.quotes_verified?.[0] ?? '';
const emailBody = encodeURIComponent(
  firstQuote ? `"${firstQuote}"\n\n${canonicalUrl}` : canonicalUrl
);

// JSON-LD
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  datePublished: data.date.toISOString().split('T')[0],
  dateModified: data.edited_at
    ? (data.edited_at as Date).toISOString().split('T')[0]
    : data.date.toISOString().split('T')[0],
  author: data.speaker.map(name => ({ '@type': 'Person', name })),
  publisher: {
    '@type': 'Organization',
    name: 'The Suhba Library',
    url: Astro.site?.toString(),
  },
  inLanguage: data.language,
  image: ogImage,
  url: canonicalUrl,
  keywords: data.topic.join(', '),
};

// Language/direction
const isRtl = data.language === 'ar' || data.language === 'ur' || data.language === 'fa';
---

<BaseLayout
  title={data.title}
  description={firstQuote || `A spiritual discourse by ${speakerList}.`}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
  lang={data.language}
  dir={isRtl ? 'rtl' : 'ltr'}
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <article class="discourse-page">

    <!-- Header image -->
    <div class="discourse-hero">
      <img
        src={ogImage}
        alt={`Header image for: ${data.title}`}
        class="discourse-hero-img"
        width="1200"
        height="630"
        loading="eager"
      />
    </div>

    <div class="discourse-body-wrapper">

      <!-- Title block -->
      <header class="discourse-header">
        <h1 class="discourse-title">{data.title}</h1>

        <div class="discourse-meta">
          <span class="meta-speaker">{speakerList}</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <time datetime={data.date.toISOString().split('T')[0]}>{gregorianDate}</time>
          {hijriDisplay && (
            <>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span>{hijriDisplay}</span>
            </>
          )}
          {!hijriDisplay && (
            <>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span class="meta-estimated" title="Islamic date estimated from Gregorian">
                est. Hijri
              </span>
            </>
          )}
          {locationParts && (
            <>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span>{locationParts}</span>
            </>
          )}
        </div>

        <div class="discourse-badges">
          <span class="reading-time" aria-label={`Estimated reading time: ${readingMinutes} minutes`}>
            {readingMinutes} min read
          </span>
          {data.transcript_quality && (
            <span class={`quality-badge quality-${data.transcript_quality}`} aria-label={`Transcript quality: ${data.transcript_quality}`}>
              {data.transcript_quality.charAt(0).toUpperCase() + data.transcript_quality.slice(1)} transcript
            </span>
          )}
          {data.edited_at && (
            <span class="edited-notice" aria-label="This discourse was updated">
              Last updated {(data.edited_at as Date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          )}
        </div>

        <!-- Watch on YouTube -->
        {data.youtube_url && (
          <a
            href={data.youtube_url}
            class="youtube-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Watch "${data.title}" on YouTube (opens in new tab)`}
            data-cf-event="youtube_click"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.8 8s-.2-1.4-.8-2c-.8-.8-1.6-.8-2-.9C16.2 5 12 5 12 5s-4.2 0-7 .1c-.4.1-1.2.1-2 .9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.2.8C6.8 19 12 19 12 19s4.2 0 7-.2c.4-.1 1.2-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.8 14.5v-5.5l5.4 2.8-5.4 2.7z"/>
            </svg>
            Watch on YouTube
          </a>
        )}
      </header>

      <!-- Discourse body -->
      <div class="prose" data-pagefind-body>
        <Content />
      </div>

      <!-- Share bar -->
      <aside class="share-bar" aria-label="Share this discourse">
        <p class="share-label">Share</p>
        <div class="share-icons">
          <a
            href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on WhatsApp"
          >WA</a>

          <a
            href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on X / Twitter"
          >𝕏</a>

          <a
            href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Telegram"
          >TG</a>

          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Facebook"
          >FB</a>

          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
            class="share-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LinkedIn"
          >LI</a>

          <a
            href={`mailto:?subject=${encodedTitle}&body=${emailBody}`}
            class="share-icon"
            aria-label="Share via Email"
          >✉</a>

          <button
            id="copy-link"
            class="share-icon"
            aria-label="Copy link to clipboard"
            data-url={canonicalUrl}
          >
            🔗
          </button>
        </div>
      </aside>

      <!-- Topic pills -->
      <div class="discourse-topics" aria-label="Topics">
        {data.topic.map(t => (
          <a href={`/topics/${encodeURIComponent(t.toLowerCase())}`} class="topic-pill">
            {t}
          </a>
        ))}
      </div>

      <!-- Related Suhbas -->
      {related.length > 0 && (
        <section class="related-suhbas" aria-labelledby="related-heading">
          <h2 class="related-heading" id="related-heading">Related Suhbas</h2>
          <div class="related-list">
            {related.map(d => (
              <DiscourseCard
                title={d.data.title}
                slug={d.data.slug}
                date={d.data.date}
                dateHijri={d.data.date_hijri}
                speakers={d.data.speaker}
                locationCountry={d.data.location_country}
                locationCity={d.data.location_city}
                topics={d.data.topic}
                transcriptQuality={d.data.transcript_quality}
              />
            ))}
          </div>
        </section>
      )}

    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .discourse-page { padding-bottom: 3rem; }

  .discourse-hero {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
  }

  .discourse-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .discourse-body-wrapper {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
    padding-top: 2rem;
  }

  .discourse-header { margin-bottom: 2rem; }

  .discourse-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .discourse-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .meta-sep { opacity: 0.4; }
  .meta-estimated { font-style: italic; opacity: 0.7; }

  .discourse-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .reading-time {
    font-size: 0.775rem;
    color: var(--color-text-secondary);
    padding: 0.2rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .quality-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    font-weight: 500;
  }

  .quality-verified { background: color-mix(in srgb, #2C5F4A 12%, transparent); color: #2C5F4A; }
  .quality-reviewed { background: color-mix(in srgb, #B8956A 12%, transparent); color: #7a5e38; }
  .quality-draft { background: color-mix(in srgb, #6B6560 12%, transparent); color: #6B6560; }

  .edited-notice {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .youtube-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    min-height: 44px;
    background: #FF0000;
    color: #fff;
    text-decoration: none;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 0.15s;
  }

  .youtube-btn:hover { opacity: 0.88; }

  /* Prose lives at max 70ch, centred on wider screens */
  .prose {
    max-width: var(--prose-width);
  }

  /* Share bar */
  .share-bar {
    margin-block: 2.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .share-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    margin: 0 0 0.75rem;
  }

  .share-icons {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .share-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    font-family: inherit;
  }

  .share-icon:hover,
  .share-icon:focus-visible {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  /* Topic pills */
  .discourse-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .topic-pill {
    font-size: 0.8rem;
    padding: 0.35rem 0.875rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-primary) 10%, transparent);
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: background 0.15s;
  }

  .topic-pill:hover { background: color-mix(in srgb, var(--color-accent-primary) 18%, transparent); }

  /* Related */
  .related-suhbas { border-top: 1px solid var(--color-border); padding-top: 2rem; }
  .related-heading { font-size: 1rem; font-weight: 600; margin: 0 0 0.5rem; }
</style>

<script>
  const copyLinkBtn = document.getElementById('copy-link') as HTMLButtonElement | null;
  copyLinkBtn?.addEventListener('click', async () => {
    const url = copyLinkBtn.dataset.url ?? window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      copyLinkBtn.textContent = '✓';
      setTimeout(() => { copyLinkBtn.textContent = '🔗'; }, 2000);
    } catch {
      copyLinkBtn.textContent = '✗';
    }
  });
</script>
