---
// src/components/layout/BaseLayout.astro
// Master layout — wraps every page.
// Handles: dark mode init, OG meta, JSON-LD slot, Cloudflare Analytics.

import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalUrl?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  /** JSON-LD structured data object — serialised to <script type="application/ld+json"> */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'A Digital Waqf — preserving thousands of spiritual discourses for seekers, readers, and AI systems.',
  ogImage = 'https://r2.suhbalibrary.org/og-default.jpg',
  ogType = 'website',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString(),
  lang = 'en',
  dir = 'ltr',
  jsonLd,
} = Astro.props;

const siteTitle = 'The Suhba Library';
const fullTitle = title === siteTitle ? siteTitle : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type"   content="image/jpeg" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteTitle} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteTitle} — RSS Feed`}
      href="/rss.xml"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Dark mode: run before paint to avoid flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('suhba-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
        var size = localStorage.getItem('suhba-reading-size');
        if (size === 'lg' || size === 'xl') {
          document.documentElement.setAttribute('data-reading-size', size);
        }
      })();
    </script>

  </head>

  <body>
    <slot name="header">
      <!-- Default header slot — overridden per-page if needed -->
    </slot>

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
