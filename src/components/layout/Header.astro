---
// src/components/layout/Header.astro
// Responsive header:
//   Mobile (<768px): logo | search icon + hamburger → slide-in drawer
//   Desktop (≥768px): logo | nav links | search icon | settings dropdown
---

<header class="site-header" role="banner">
  <div class="header-inner">
    <!-- Wordmark -->
    <a href="/" class="wordmark" aria-label="The Suhba Library — home">
      The Suhba Library
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/search">Suhbas</a>
      <a href="/topics">Topics</a>
      <a href="/speakers">Speakers</a>
      <a href="/about">About</a>
    </nav>

    <!-- Right controls -->
    <div class="header-controls">
      <!-- Search icon -->
      <a href="/search" aria-label="Search discourses" class="icon-btn">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>

      <!-- Dark mode toggle (desktop) -->
      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.22 4.22l1.42 1.42M14.36 14.36l1.42 1.42M4.22 15.78l1.42-1.42M14.36 5.64l1.42-1.42"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M17 11.5A7 7 0 1 1 8.5 3a5 5 0 0 0 8.5 8.5z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

      <!-- Hamburger (mobile only) -->
      <button
        id="menu-toggle"
        class="icon-btn mobile-only"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div
  id="mobile-drawer"
  class="mobile-drawer"
  role="dialog"
  aria-label="Navigation menu"
  aria-modal="true"
  hidden
>
  <div class="drawer-inner">
    <button
      id="drawer-close"
      class="icon-btn drawer-close"
      aria-label="Close navigation menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <nav aria-label="Mobile navigation">
      <a href="/search">Suhbas</a>
      <a href="/topics">Topics</a>
      <a href="/speakers">Speakers</a>
      <a href="/about">About</a>
    </nav>

    <div class="drawer-settings">
      <p class="settings-label">Settings</p>

      <!-- Dark mode toggle (mobile) -->
      <button id="theme-toggle-mobile" class="settings-row" aria-pressed="false">
        <span>Dark mode</span>
        <span class="toggle-indicator" aria-hidden="true"></span>
      </button>

      <!-- Font size slider -->
      <div class="settings-row">
        <label for="font-size-select">Text size</label>
        <select id="font-size-select" aria-label="Select reading text size">
          <option value="sm">Small</option>
          <option value="">Normal</option>
          <option value="lg">Large</option>
          <option value="xl">Extra large</option>
        </select>
      </div>
    </div>
  </div>
</div>

<!-- Drawer overlay -->
<div id="drawer-overlay" class="drawer-overlay" hidden aria-hidden="true"></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-light);
    border-bottom: 1px solid var(--color-border);
  }

  html.dark .site-header {
    background: var(--color-bg-dark);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 850px;
    margin-inline: auto;
    padding-inline: 1rem;
    height: 3.5rem;
  }

  .wordmark {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    text-decoration: none;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: none;
    gap: 1.75rem;
  }

  .desktop-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: var(--color-accent-primary);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    border-radius: 0.375rem;
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
    /* Ensure min 44×44px touch target */
    min-width: 44px;
    min-height: 44px;
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    color: var(--color-accent-primary);
    background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent);
  }

  .mobile-only { display: flex; }
  .desktop-only { display: none; }

  /* Dark mode icon logic */
  html:not(.dark) .icon-moon { display: none; }
  html.dark .icon-sun { display: none; }

  /* Mobile drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(20rem, 85vw);
    background: var(--color-surface-light);
    z-index: 200;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
  }

  html.dark .mobile-drawer {
    background: var(--color-surface-dark);
  }

  .mobile-drawer:not([hidden]) {
    transform: translateX(0);
  }

  .mobile-drawer[hidden] {
    display: block; /* keep in DOM for animation; hidden via transform */
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.4);
    z-index: 199;
  }

  .drawer-overlay[hidden] {
    display: none;
  }

  .drawer-inner {
    padding: 1.25rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: 100%;
  }

  .drawer-close {
    align-self: flex-end;
  }

  .drawer-inner nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .drawer-inner nav a {
    display: block;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: 1.05rem;
  }

  .drawer-settings {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .settings-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    width: 100%;
    cursor: pointer;
    color: var(--color-text-primary);
    font-size: 1rem;
    font-family: inherit;
  }

  @media (min-width: 768px) {
    .desktop-nav { display: flex; }
    .mobile-only { display: none !important; }
    .desktop-only { display: flex !important; }
  }
</style>

<script>
  // -------------------------------------------------------
  // Dark mode
  // -------------------------------------------------------
  function setTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('suhba-theme', dark ? 'dark' : 'light');
    document.querySelectorAll<HTMLButtonElement>('#theme-toggle, #theme-toggle-mobile')
      .forEach(btn => btn.setAttribute('aria-pressed', String(dark)));
  }

  const isDark = () => document.documentElement.classList.contains('dark');

  document.getElementById('theme-toggle')?.addEventListener('click', () => setTheme(!isDark()));
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', () => setTheme(!isDark()));

  // Sync initial aria-pressed
  document.querySelectorAll<HTMLButtonElement>('#theme-toggle, #theme-toggle-mobile')
    .forEach(btn => btn.setAttribute('aria-pressed', String(isDark())));

  // -------------------------------------------------------
  // Font size
  // -------------------------------------------------------
  const sizeSelect = document.getElementById('font-size-select') as HTMLSelectElement | null;
  if (sizeSelect) {
    const current = localStorage.getItem('suhba-reading-size') ?? '';
    sizeSelect.value = current;
    sizeSelect.addEventListener('change', () => {
      const v = sizeSelect.value;
      if (v === 'lg' || v === 'xl') {
        document.documentElement.setAttribute('data-reading-size', v);
        localStorage.setItem('suhba-reading-size', v);
      } else {
        document.documentElement.removeAttribute('data-reading-size');
        localStorage.removeItem('suhba-reading-size');
      }
    });
  }

  // -------------------------------------------------------
  // Mobile drawer
  // -------------------------------------------------------
  const drawer = document.getElementById('mobile-drawer') as HTMLElement | null;
  const overlay = document.getElementById('drawer-overlay') as HTMLElement | null;
  const menuBtn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('drawer-close') as HTMLButtonElement | null;

  function openDrawer() {
    if (!drawer || !overlay || !menuBtn) return;
    drawer.hidden = false;
    overlay.hidden = false;
    menuBtn.setAttribute('aria-expanded', 'true');
    // Move focus to close button
    document.getElementById('drawer-close')?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !overlay || !menuBtn) return;
    drawer.hidden = true;
    overlay.hidden = true;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.focus();
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer?.hidden) closeDrawer();
  });
</script>
