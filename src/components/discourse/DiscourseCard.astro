---
// src/components/discourse/DiscourseCard.astro
// Compact list card used in: Latest Suhbas, topic pages, speaker pages, search results.

interface Props {
  title: string;
  slug: string;
  date: Date;
  dateHijri?: string;
  speakers: string[];
  locationCountry: string;
  locationCity?: string;
}

const {
  title,
  slug,
  date,
  dateHijri,
  speakers,
  locationCountry,
  locationCity,
} = Astro.props;

const gregorianDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const location = locationCity
  ? `${locationCity}, ${locationCountry}`
  : locationCountry;

const speakerList = speakers.join(', ');
---

<article class="discourse-card">
  <a href={`/suhba/${slug}`} class="card-link">
    <h2 class="card-title">{title}</h2>
  </a>

  <p class="card-meta">
    <span class="meta-speaker">{speakerList}</span>
    <span class="meta-sep" aria-hidden="true">·</span>
    <time datetime={date.toISOString().split('T')[0]}>{gregorianDate}</time>
    {dateHijri && (
      <>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-hijri">{dateHijri}</span>
      </>
    )}
    <span class="meta-sep" aria-hidden="true">·</span>
    <span class="meta-location">{location}</span>
  </p>
</article>

<style>
  .discourse-card {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.375rem;
    line-height: 1.35;
    transition: color 0.15s;
  }

  .card-link:hover .card-title,
  .card-link:focus-visible .card-title {
    color: var(--color-accent-primary);
  }

  .card-meta {
    font-size: 0.825rem;
    color: var(--color-text-secondary);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
  }

  .meta-sep { opacity: 0.4; }
</style>
