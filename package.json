{
  "name": "suhba-library",
  "version": "0.1.0",
  "private": true,
  "description": "The Suhba Library — a Digital Waqf archive of spiritual discourses",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "pnpm run pagefind",
    "pagefind": "pagefind --site dist --output-path dist/pagefind",
    "validate": "astro check",
    "lint:slugs": "node scripts/check-slugs.mjs",
    "lint:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.7.0",
    "zod": "^3.23.0",
    "hijri-converter": "^1.1.1",
    "pagefind": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
